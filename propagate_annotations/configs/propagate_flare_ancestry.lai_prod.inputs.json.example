{
  "_comment": "Per-chromosome ancestry propagation onto the phased callset (GT:AN1:AN2 at every site, incl. SVs) for FelixGenome joint_vcfs. Root entity flare_lai_prod, after FlareByPopulationProd has written anc_vcf there. target_vcf is ligated_vcf, the SHAPEIT4 ligated BCF + .csi. Note gt_vcf holds the SAME records: its header shows the conversion was 'bcftools view --output-type z' with no type or region filter, so both carry SNVs, indels and SVs and either would work as the target; the BCF is the primary artifact. The SNV-only restriction people remember is applied INSIDE FlareByPopulation (biallelic_snvs_only -> bcftools -m2 -M2 -v snps at SubsetOnePopulation, false for the pin recipe) and by FLARE painting only at gnomAD-LAI reference-panel sites; it is not a property of the stored callsets. Map outputs annotated_vcf -> this.joint_gt_an_vcf, annotated_vcf_index -> this.joint_gt_an_vcf_index.",
  "PropagateFlareAncestry.flare_vcf": "this.anc_vcf",
  "PropagateFlareAncestry.flare_vcf_index": "this.anc_vcf_index",
  "PropagateFlareAncestry.target_vcf": "this.ligated_vcf",
  "PropagateFlareAncestry.target_vcf_index": "this.ligated_vcf_idx",
  "PropagateFlareAncestry.region": "this.chrom",
  "PropagateFlareAncestry.prefix": "this.output_prefix",
  "PropagateFlareAncestry.propagate_script": "gs://WORKSPACE_BUCKET/scripts/propagate_flare_ancestry.py",
  "PropagateFlareAncestry.gcs_project": "YOUR_TERRA_GOOGLE_PROJECT",
  "PropagateFlareAncestry.docker": "us-central1-docker.pkg.dev/broad-dsp-lrma/aou-lr/aou-flare-bcftools:1.24",
  "PropagateFlareAncestry.min_coverage_rate": 0.95,
  "PropagateFlareAncestry.fail_on_low_coverage": true,
  "PropagateFlareAncestry.format_tags": "AN1,AN2"
}
