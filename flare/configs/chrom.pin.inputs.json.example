{
  "_comment": "Genome-wide original-FLARE pin (same recipe as chr20_flat_props_pin_t): whole cohort, EM off, T pinned AFR:8 AMR:12 others:8, FLARE defaults for props/weights/mu. Root entity aou_lr_chrom. Map outputs anc_vcf -> this.lai_anc_vcf, anc_vcf_index -> this.lai_anc_vcf_index, models_tsv -> this.lai_models_tsv.",
  "FlareByPopulation.covariates": "gs://WORKSPACE_BUCKET/covariates/covariates.source_rebuilt.csv.gz",
  "FlareByPopulation.gt_vcf": "this.phased_vcf",
  "FlareByPopulation.gt_vcf_index": "this.phased_vcf_index",
  "FlareByPopulation.ref_vcf": "this.gnomad_lai_vcf",
  "FlareByPopulation.ref_vcf_index": "this.gnomad_lai_vcf_index",
  "FlareByPopulation.ref_panel": "gs://BUCKET/Reference_plink/aou_1000genomes.refmap",
  "FlareByPopulation.map_file": "this.genetic_map",
  "FlareByPopulation.split_script": "gs://WORKSPACE_BUCKET/scripts/flare_split_samples.py",
  "FlareByPopulation.summarize_script": "gs://WORKSPACE_BUCKET/scripts/flare_summarize_models.py",
  "FlareByPopulation.flare_model_script": "gs://WORKSPACE_BUCKET/scripts/flare_model.py",
  "FlareByPopulation.flare_site_stats_script": "gs://WORKSPACE_BUCKET/scripts/flare_site_stats.py",
  "FlareByPopulation.indel_flank_script": "gs://WORKSPACE_BUCKET/scripts/flare_build_indel_flanks.py",
  "FlareByPopulation.output_prefix": "this.aou_lr_chrom_id",
  "FlareByPopulation.exclude_controls": true,
  "FlareByPopulation.region": "",
  "FlareByPopulation.update_p": true,
  "FlareByPopulation.min_maf": 0.005,
  "FlareByPopulation.min_mac": 50,
  "FlareByPopulation.seed": 12345,
  "FlareByPopulation.gcs_project": "YOUR_TERRA_GOOGLE_PROJECT",
  "FlareByPopulation.include_pops": "",
  "FlareByPopulation.drop_pops": "",
  "FlareByPopulation.allow_unrepresented_pops": true,
  "FlareByPopulation.em": false,
  "FlareByPopulation.gen": 8,
  "FlareByPopulation.gen_by_pop": "AFR:8,AMR:12,EUR:8,EAS:8,SAS:8,MID:8",
  "FlareByPopulation.gen_by_pop_allow_default": false,
  "FlareByPopulation.inherit_props": true,
  "FlareByPopulation.inherit_panel_weights": true,
  "FlareByPopulation.inherit_mu": true,
  "FlareByPopulation.probs": false,
  "FlareByPopulation.flare_preemptible": 1
}
