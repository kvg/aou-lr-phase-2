 #include "Duplicate_vec.hpp"
 
 #include <boost/math/distributions/beta.hpp>
+#include <cstdlib>
+
+// AoU-LR patch (dosage carrier QC). With FELIX_DOSAGE_QC=carrier, the
+// admixed single-variant VCF path (mainMarkerAdmixedInCPP) filters on carrier
+// counts instead of sum(DS) "allele counts". Repeat-length dosages are coded
+// relative to REF (REF haplotype = 0) and can be negative or exceed the
+// haplotype count, so sum(DS) is not an allele count. Test statistics, SPA,
+// Firth and the joint tests are unchanged. Off by default.
+static bool aou_dosage_carrier_qc() {
+  static const bool on = [] {
+    const char* v = std::getenv("FELIX_DOSAGE_QC");
+    bool enabled = (v != nullptr) && (std::string(v) == "carrier");
+    if (enabled) {
+      std::cout << "FELIX_DOSAGE_QC=carrier: admixed VCF QC uses carrier counts" << std::endl;
+    }
+    return enabled;
+  }();
+  return on;
+}
+
+// Carrier-count stand-ins for MAC / MAF: samples with a non-zero dosage
+// versus samples without, among samples eligible for this test (carrying at
+// least one ancestry-k haplotype; every sample for the combined test).
+static void aou_carrier_mac_maf(const arma::vec& t_GVec, const arma::vec* t_ancVec,
+                                double& t_MAC, double& t_MAF) {
+  double eligible = 0.0;
+  double carriers = 0.0;
+  for (arma::uword s = 0; s < t_GVec.n_elem; ++s) {
+    if (t_ancVec != nullptr && (*t_ancVec)(s) <= 0.0) {
+      continue;
+    }
+    eligible += 1.0;
+    if (t_GVec(s) != 0.0) {
+      carriers += 1.0;
+    }
+  }
+  t_MAC = std::min(carriers, eligible - carriers);
+  t_MAF = (eligible > 0.0) ? t_MAC / eligible : 0.0;
+}
 
