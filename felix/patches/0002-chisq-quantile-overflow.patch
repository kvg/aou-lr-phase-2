+}
+
+// AoU-LR patch (chi-square quantile overflow). boost::math::quantile on a
+// chi_squared distribution calls gamma_q_inv, which THROWS "Overflow Error"
+// instead of returning an infinite quantile when the upper-tail probability
+// is 0. p == 0 reaches the two call sites below legitimately:
+// convertStringtoDoublePval (Main.cpp) returns 0 when std::stod cannot parse
+// a p-value string that underflows double, which happens for the most
+// extreme markers in a scan. The throw propagates out of Rcpp as an R error
+// and kills the whole step-2 chunk, losing ~10,000 markers' results.
+//
+// The code below already anticipates an infinite qval -- it zeroes entries
+// where VarS is inf, and guards VarQ_2 == 0 with r = 1.0 -- so returning the
+// limit is what the surrounding logic was written for. Finite p is handed to
+// boost unchanged, so no currently-succeeding marker changes value.
+static inline double aou_chisq_upper_quantile(const boost::math::chi_squared& dist,
+                                              double p) {
+  if (std::isnan(p)) return std::numeric_limits<double>::quiet_NaN();
+  if (p <= 0.0) return std::numeric_limits<double>::infinity();
+  if (p >= 1.0) return 0.0;
+  return boost::math::quantile(boost::math::complement(dist, p));
 }
 
