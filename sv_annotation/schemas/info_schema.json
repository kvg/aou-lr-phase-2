{
  "info_fields": [
    {
      "id": "SOURCE_VCF",
      "number": "1",
      "type": "String",
      "description": "Callset partition: main, bnd, or large"
    },
    {
      "id": "REGION_CLASS",
      "number": "1",
      "type": "String",
      "description": "repetitive if overlapping union of rmsk/simpleRepeat/genomicSuperDups; else non_repetitive"
    },
    {
      "id": "CADD_SV_PHRED",
      "number": "1",
      "type": "Float",
      "description": "CADD-SV PHRED score generated in-pipeline"
    },
    {
      "id": "CADD_SV_BIN",
      "number": "1",
      "type": "String",
      "description": "low (<10), mid (10-20), high (>=20), or unscored"
    },
    {
      "id": "FREQ_CLASS",
      "number": "1",
      "type": "String",
      "description": "singleton, polymorphic, major, or shared within the analysis cohort"
    }
  ],
  "optional_info_fields": [
    {"id": "TR_DETECTED", "number": "1", "type": "Integer", "description": "Tandem-repeat flag from str_analysis"},
    {"id": "TR_MOTIF", "number": "1", "type": "String", "description": "Tandem-repeat motif"},
    {"id": "RU_TEST", "number": "0", "type": "Flag", "description": "INS/DEL/DUP overlapping a tandem array with a usable period; eligible for repeat-unit dosage"},
    {"id": "PERIOD", "number": "1", "type": "Integer", "description": "Tandem repeat period in bp from simpleRepeat/TRF or allele sequence"},
    {"id": "MOTIF", "number": "1", "type": "String", "description": "Tandem repeat consensus motif"},
    {"id": "CN_REF", "number": "1", "type": "Float", "description": "Reference copy number of the overlapping tandem array; omitted means extra-units-vs-REF"},
    {"id": "RU", "number": "A", "type": "Integer", "description": "Repeat-unit count of each ALT (SVLEN/PERIOD for symbolic ALTs)"},
    {"id": "REMAP_CLASS", "number": "1", "type": "String", "description": "truvari anno remap classification"},
    {"id": "ME_TYPE", "number": "1", "type": "String", "description": "MEI type from L1ME-AID (ALU/LINE/SVA)"},
    {"id": "ME_SUBFAM", "number": "1", "type": "String", "description": "MEI subfamily"}
  ]
}
